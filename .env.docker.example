# Separate env file for docker compose variable substitution.
# Copy to .env.docker, fill in real values, then:
#     docker compose --env-file .env.docker up -d --build
#
# NOTE: APP_KEY must be a real key. Generate one locally with
#     php artisan key:generate --show
# and paste the "base64:..." value here.

# Host port your native nginx will proxy to (container listens on 80).
APP_PORT=8080

# --- Container / runtime ---
TZ=Asia/Baku
# Directory (mounted into the container) of CA certs to trust: mail + MinIO.
EXTRA_CA_DIR=/certs

# --- App ---
APP_NAME=DMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dms.example.az
APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (SQL Server) ---
DB_CONNECTION=sqlsrv
DB_HOST=your-sqlserver-host
DB_PORT=1433
DB_DATABASE=dms
DB_USERNAME=dms_user
DB_PASSWORD=

# --- Session / cache / queue / broadcast ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Filesystems / MinIO (all external; set these to your MinIO) ---
FILESYSTEM_DISK=local
ATTACHMENT_DISK=minio
MINIO_ENDPOINT=https://your-minio-host:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=dms
MINIO_REGION=us-east-1
# In-container path if you mount a CA bundle (see docker-compose volumes); else leave empty.
MINIO_SSL_CA=

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=no-reply@example.az
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend ---
VITE_APP_NAME="${APP_NAME}"
