[Unit]
Description=DMS Laravel Queue Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/dms-app
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600 --timeout=120
Restart=always
RestartSec=5
StandardOutput=append:/var/log/dms-queue.log
StandardError=append:/var/log/dms-queue.log

[Install]
WantedBy=multi-user.target
